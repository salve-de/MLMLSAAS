PORT=3000
HOST=127.0.0.1
BASE_URL=http://localhost:3000
DATABASE_PATH=./data/platform.db
DEMO_DATABASE_PATH=./data/demo.db
# Required in production: generate with node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=
# Set only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# Disabled until a compliant payment provider adapter and business review are complete.
LIVE_PAYMENTS_ENABLED=false
PAYOUTS_ENABLED=false
BILLING_WEBHOOK_SECRET=
PAYMENT_APPROVAL_REFERENCE=
HOLD_DAYS=30
MIN_PAYOUT_JPY=3000
# For `npm run admin` only. Never commit actual credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=
